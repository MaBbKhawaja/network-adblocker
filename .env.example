# Copy to .env and fill in. .env is gitignored. `./build.sh secrets` regenerates netmon/secrets.h from it.

# ---- Router admin (printed on the card that came with the router) ----
ROUTER_URL=https://192.168.1.1
ROUTER_USER=admin
ROUTER_PASSWORD=
ROUTER_SERIAL=
ROUTER_MAC=

# ---- Wi-Fi the board and every device join ----
WIFI_SSID=""
WIFI_PASSWORD=

# ---- The ESP32 (netmon) ----
NETMON_HOST=adblocker
NETMON_IP=192.168.1.53
NETMON_GATEWAY=192.168.1.1
NETMON_NETMASK=255.255.255.0
NETMON_MAC=
NETMON_SERIAL_PORT=/dev/cu.usbmodem2101
# other boards this one shows on its dashboard and mirrors settings to (comma-separated IPs)
NETMON_PEERS=192.168.1.54
# over-the-air update password (./build.sh ota, NODE=2 ./build.sh ota) — same on every board
OTA_PASSWORD=
# ---- Second board (redundancy): NODE=2 ./build.sh all — DNS Server 2 on the router ----
NETMON2_HOST=vpn
NETMON2_IP=192.168.1.54
NETMON2_SERIAL_PORT=
NETMON2_PEERS=192.168.1.53
NTFY_TOPIC=

# ---- Upstream DNS ----
UPSTREAM_DNS_1=1.1.1.1
UPSTREAM_DNS_2=8.8.8.8

# ---- Other fixed addresses on the LAN ----
MACBOOK_IP=
