<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Restarts the Invidious web container daily at 04:30 (the Invidious docs ask for at least a daily
     restart). Installed into ~/Library/LaunchAgents by ./setup.sh --daily-restart, which also fixes the path. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.network-adblocker.invidious-restart</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/bin/docker</string><string>compose</string>
    <string>-f</string><string>/Users/mabb/Projects/network-adblocker/invidious/docker-compose.yml</string>
    <string>restart</string><string>invidious</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/tmp/invidious-restart.log</string>
  <key>StandardErrorPath</key><string>/tmp/invidious-restart.log</string>
</dict></plist>
